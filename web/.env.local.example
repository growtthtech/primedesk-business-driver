# NEVER commit this file. Copy to .env.local and fill.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/primedesk
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# R2 (Phase 2, save now, use later)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=primedesk-uploads
R2_PUBLIC_URL=
# ZeptoMail (needs domain - for later)
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM=noreply@yourdomain.ng
# Gmail SMTP (no domain needed - pilot path)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Termii SMS for phone OTP (production needs key + approved sender ID)
TERMII_API_KEY=
TERMII_SENDER_ID=PrimeDesk
TERMII_CHANNEL=generic
# Later Phase 3
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
TERMII_API_KEY=
TERMII_SENDER_ID=PrimeDesk
